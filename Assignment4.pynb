          "text": [
            "\n",
            "Dataset: [10, 20, 30, 40, 50]\n",
            "Mean: 30\n",
            "Median: 30\n",
            "Population Standard Deviation: 14.142135623730951\n",
            "Variance: 200\n",
            "Minimum: 10\n",
            "Maximum: 50\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# NumPy calculations\n",
        "arr = np.array(data)\n",
        "\n",
        "print(\"\\nNumPy Mean:\", np.mean(arr))\n",
        "print(\"NumPy Median:\", np.median(arr))\n",
        "print(\"NumPy Standard Deviation:\", np.std(arr))"
      ],
