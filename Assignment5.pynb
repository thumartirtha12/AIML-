      "source": [
        "import math\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from scipy import stats\n",
        "\n",
        "# 1. Math library\n",
        "print(\"Square root of 25:\", math.sqrt(25))\n",
        "print(\"Factorial of 5:\", math.factorial(5))\n",
        "print(\"Value of pi:\", math.pi)\n",
        "\n",
        "# 2. NumPy library\n",
        "arr = np.array([10, 20, 30, 40, 50])\n",
        "\n",
        "print(\"\\nNumPy Array:\", arr)\n",
        "print(\"Mean:\", np.mean(arr))\n",
        "print(\"Sum:\", np.sum(arr))\n",
        "print(\"Maximum:\", np.max(arr))\n",
        "print(\"Standard Deviation:\", np.std(arr))\n",
        "\n",
        "# 3. SciPy library\n",
        "data = [10, 20, 20, 30, 40, 50]\n",
        "\n",
        "print(\"\\nSciPy Mean:\", stats.tmean(data))\n",
        "print(\"SciPy Mode:\", stats.mode(data))\n",
        "print(\"SciPy Z-scores:\", stats.zscore(data))"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Pandas library\n",
        "df = pd.DataFrame({\n",
        "    \"Name\": [\"Amit\", \"Priya\", \"Rahul\", \"Neha\", \"Karan\"],\n",
        "    \"Marks\": [75, 85, 65, 90, 80],\n",
        "    \"Age\": [20, 21, 20, 22, 21]\n",
        "})\n",
        "\n",
        "print(\"\\nDataset:\")\n",
        "print(df)\n",
        "\n",
        "print(\"\\nDataset Information:\")\n",
        "print(df.describe())\n",
        "\n",
        "print(\"\\nAverage Marks:\", df[\"Marks\"].mean())\n",
        "\n",
        "# 5. Matplotlib visualization\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.bar(df[\"Name\"], df[\"Marks\"])\n",
        "plt.xlabel(\"Student Name\")\n",
        "plt.ylabel(\"Marks\")\n",
        "plt.title(\"Student Marks\")\n",
        "plt.show()\n",
        "\n",
        "# 6. Seaborn visualization\n",
        "plt.figure(figsize=(7, 4))\n",
        "sns.histplot(data=df, x=\"Marks\", bins=5, kde=True)\n",
        "plt.title(\"Distribution of Student Marks\")\n",
        "plt.show()\n",
        "\n",
        "# Correlation heatmap\n",
        "plt.figure(figsize=(6, 4))\n",
        "sns.heatmap(df[[\"Marks\", \"Age\"]].corr(),\n",
        "            annot=True, cmap=\"coolwarm\")\n",
        "plt.title(\"Correlation Heatmap\")\n",
        "plt.show()"
      ],
